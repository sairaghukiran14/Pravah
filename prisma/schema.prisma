generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String         @id @default(cuid())
  name                String?
  email               String         @unique
  emailVerified       DateTime?
  image               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  onboardingCompleted Boolean        @default(false)
  credits             Float          @default(20.00)
  // Any session issued before this moment is refused. Bumping it is what
  // "sign out everywhere" does — with the JWT strategy there is no server-side
  // session row to delete, so revocation has to be a claim the token is checked
  // against rather than a record that gets removed.
  sessionsRevokedAt   DateTime?
  accounts            Account[]
  apiKeys             ApiKey[]
  apiLogs             ApiRequestLog[]
  auditLogs           AuditLog[]
  transactions        CreditTransaction[]
  orders              PaymentOrder[]
  projects            Project[]
  sessions            Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id             String          @id @default(cuid())
  name           String
  description    String?
  userId         String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  pipelines      Pipeline[]
  documentChunks DocumentChunk[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Pipeline {
  id          String         @id @default(cuid())
  name        String
  description String?
  projectId   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  // Shape of this pipeline when it was seeded from the shipped library, if it
  // was. If the pipeline still hashes to this, the user has not edited it and a
  // corrected template may safely replace it. Null for user-created pipelines,
  // which are never touched by seeding.
  seedFingerprint String?
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  edges       PipelineEdge[]
  nodes       PipelineNode[]
  runs        PipelineRun[]
  versions    PipelineVersion[]
  evalRuns    EvalRun[]
  documentChunks DocumentChunk[]

  @@index([projectId])
}

model PipelineNode {
  id         String   @id @default(cuid())
  pipelineId String
  type       String
  label      String
  positionX  Float
  positionY  Float
  config     Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([pipelineId])
}

model PipelineEdge {
  id           String   @id @default(cuid())
  pipelineId   String
  source       String
  target       String
  sourceHandle String?
  targetHandle String?
  createdAt    DateTime @default(now())
  pipeline     Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([pipelineId])
}

model PipelineRun {
  id         String    @id @default(cuid())
  pipelineId String
  status     String    @default("pending")
  input      Json?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  // Credit held for this run, cleared when the run settles. Storing it on the
  // row is what lets the reaper return the exact amount held by a run whose
  // process was killed before it could settle itself — and clearing it is the
  // claim that stops settlement and reaping from both refunding the same hold.
  reservedCredits Float?
  // Credits consumed per node type. On one shared upstream key this is what
  // makes consumption attributable to a tenant — the credit ledger records that
  // a run cost something, not which capacity it consumed.
  costBreakdown   Json?
  apiKeyId        String?
  source          String        @default("ui") // "ui" | "api"
  nodeRuns        NodeRun[]
  apiKey          ApiKey?       @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  pipeline        Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([pipelineId])
  @@index([apiKeyId])
  @@index([status, startedAt])
}

model NodeRun {
  id          String      @id @default(cuid())
  runId       String
  nodeId      String
  nodeType    String
  status      String      @default("pending")
  input       Json?
  output      Json?
  error       String?
  durationMs  Int?
  retryCount  Int         @default(0)
  cost        Float       @default(0)
  tokenUsage  Json?
  startedAt   DateTime?
  finishedAt  DateTime?
  run         PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([nodeId])
}

/**
 * Record of security-relevant actions.
 *
 * Separate from CreditTransaction, which is a financial ledger and says nothing
 * about who changed a pipeline, who ran one, or from where. Rows are written
 * best-effort: an audit failure must never take down the action it describes,
 * because refusing to delete a pipeline because the log is unavailable is worse
 * than the missing line.
 */
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  /** Verb in dotted form, e.g. pipeline.delete, session.revoke. */
  action     String
  /** What was acted on, where the action names one. */
  targetType String?
  targetId   String?
  /** Action-specific detail. Never contains customer document or audio content. */
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action])
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  type        String
  description String
  createdAt   DateTime @default(now())
  // Without this relation the ledger had no foreign key, so deleting an account
  // left its transactions behind pointing at a user that no longer existed —
  // rows that cannot be attributed to anyone and cannot be erased on request.
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PaymentOrder {
  id                String   @id
  userId            String
  amount            Float
  currency          String   @default("INR")
  status            String
  // Unique: the database refuses to record the same Razorpay payment against
  // two orders, so a replayed payment cannot be credited twice even if the
  // application logic is wrong.
  razorpayPaymentId String?  @unique
  razorpaySignature String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PipelineVersion {
  id          String   @id @default(cuid())
  pipelineId  String
  version     Int
  name        String?
  description String?
  nodes       Json     // snapshot of nodes
  edges       Json     // snapshot of edges
  createdAt   DateTime @default(now())
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, version])
  @@index([pipelineId])
}

model EvalDataset {
  id          String            @id @default(cuid())
  userId      String
  projectId   String?
  name        String
  description String?
  domain      String            // "stt" | "translate" | "llm" | "general"
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  items       EvalDatasetItem[]
  evalRuns    EvalRun[]

  @@index([userId])
}

model EvalDatasetItem {
  id             String      @id @default(cuid())
  datasetId      String
  name           String?
  input          Json        // e.g. { text: "..." }
  expectedOutput Json?       // e.g. { text: "..." }
  criteria       Json?       // validation parameters
  createdAt      DateTime    @default(now())
  dataset        EvalDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results        EvalResult[]

  @@index([datasetId])
}

model EvalRun {
  id                String       @id @default(cuid())
  pipelineId        String
  pipelineVersionId String?
  datasetId         String
  userId            String
  status            String       @default("pending") // "pending" | "running" | "completed" | "failed"
  summary           Json?        // aggregated metrics
  startedAt         DateTime     @default(now())
  finishedAt        DateTime?
  dataset           EvalDataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  pipeline          Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  results           EvalResult[]

  @@index([pipelineId])
  @@index([datasetId])
}

model EvalResult {
  id              String          @id @default(cuid())
  evalRunId       String
  datasetItemId   String
  status          String          // "passed" | "failed" | "error"
  actualOutput    Json?
  durationMs      Int?
  cost            Float?
  scores          Json            // metric scores { wer?: 0.05, bleu?: 0.90 }
  judgeReasoning  String?
  error           String?
  evalRun         EvalRun         @relation(fields: [evalRunId], references: [id], onDelete: Cascade)
  datasetItem     EvalDatasetItem @relation(fields: [datasetItemId], references: [id], onDelete: Cascade)

  @@index([evalRunId])
  @@index([datasetItemId])
}

model RegressionComparison {
  id             String   @id @default(cuid())
  userId         String
  baselineRunId  String
  candidateRunId String
  datasetId      String
  summary        Json
  createdAt      DateTime @default(now())

  @@index([userId])
}

model ApiKey {
  id           String          @id @default(cuid())
  name         String
  keyHash      String          @unique
  keyPrefix    String          // e.g. "pf_live_abc12"
  userId       String
  expiresAt    DateTime?       // Null = Never expires
  lastUsedAt   DateTime?
  createdAt    DateTime        @default(now())
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pipelineRuns PipelineRun[]
  apiLogs      ApiRequestLog[]

  @@index([userId])
  @@index([keyHash])
}

model ApiRequestLog {
  id          String    @id @default(cuid())
  userId      String
  apiKeyId    String?
  pipelineId  String?
  endpoint    String
  method      String    @default("POST")
  statusCode  Int
  durationMs  Int?
  cost        Float     @default(0)
  ip          String?
  userAgent   String?
  error       String?
  createdAt   DateTime  @default(now())
  apiKey      ApiKey?   @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([apiKeyId])
}

model DocumentChunk {
  id          String    @id @default(cuid())
  projectId   String
  pipelineId  String?
  runId       String?
  chunkIndex  Int
  content     String    @db.Text
  metadata    Json?     @default("{}")
  createdAt   DateTime  @default(now())

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pipeline    Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([pipelineId])
  @@index([runId])
}


