# ─────────────────────────────────────────────────
# Pravah — Environment Variables Template
# Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────────

# ── Auth.js / NextAuth v5 ──────────────────────
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=your_google_client_id_here
AUTH_GOOGLE_SECRET=your_google_client_secret_here
AUTH_SECRET=generate_a_random_32_char_secret_here

# ── Neon PostgreSQL Database ───────────────────
# Pooled URL for app runtime queries (with -pooler in hostname)
DATABASE_URL="postgresql://neondb_owner:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct URL for Prisma migrations
DIRECT_URL="postgresql://neondb_owner:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Sarvam AI (Speech / Translation / TTS) ────
SARVAM_API_KEY=your_sarvam_api_key_here
# Optional — payload-size limits (defaults shown)
# SARVAM_MAX_AUDIO_SIZE_MB=10
# SARVAM_MAX_TEXT_LENGTH=5000

# ── Cloudflare R2 Object Storage ───────────────
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name

# ── Razorpay (Payments) ──────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Optional — maximum single top-up amount (default 100000)
# MAX_TOPUP_AMOUNT=100000

# ── Rate limiting (Upstash Redis) ─────────────
# REQUIRED IN PRODUCTION. Without these the limiter falls back to per-instance
# memory, which does not hold across serverless instances — i.e. no real limit.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
# Optional — token budget per user per minute (default 120). Routes spend
# tokens by cost: cheap reads 1, Sarvam calls 5-10, a pipeline run 25.
# RATE_LIMIT_TOKENS_PER_MIN=120

# ── Signup ────────────────────────────────────
# Free credits granted on account creation, also written to the ledger.
# Set to 0 to disable the welcome grant.
# SIGNUP_CREDIT_GRANT=20

# ── Pipeline run limits ───────────────────────
# Credits held up front per run, refunded down to actual cost on completion
# RUN_RESERVATION_CREDITS=10
# Max simultaneous in-flight runs per user
# MAX_CONCURRENT_RUNS=3
